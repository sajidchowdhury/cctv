# ─────────────────────────────────────────────
# CCTV Inventory SaaS — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────

# Database (dev: SQLite; prod: PostgreSQL connection string)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# NextAuth (S03)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Storage adapter (S01: local; prod: r2 | s3 | minio)
STORAGE_DRIVER="local"
STORAGE_BASE_DIR="uploads"
# S3/R2 (prod)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Notifier adapter (S01: console; prod: resend + sslwireless | twilio)
SMS_PROVIDER="console"
EMAIL_PROVIDER="console"
# Resend (prod email)
# RESEND_API_KEY=""
# SSL Wireless / Twilio (prod SMS)
# SMS_API_KEY=""
# SMS_SENDER=""

# Super-admin digest SMS recipient (doc §3.3.1)
ADMIN_PHONE="01XXXXXXXXX"

# App
APP_TIMEZONE="Asia/Dhaka"
APP_CURRENCY="BDT"
